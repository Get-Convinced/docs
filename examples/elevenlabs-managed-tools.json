[
  {
    "tool_config": {
      "type": "client",
      "name": "show_slide",
      "description": "Show one exact slide filename from the current managed slide catalog.",
      "parameters": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "filename"
        ],
        "additionalProperties": false
      },
      "expects_response": true,
      "execution_mode": "immediate",
      "response_timeout_secs": 20
    }
  },
